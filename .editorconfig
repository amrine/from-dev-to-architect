# EditorConfig is awesome: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml}]
indent_size = 4

[*.{yml,yaml,json,vue,css,md}]
indent_size = 2

# Preserve meaningful trailing whitespace in Markdown (hard line breaks)
[*.md]
trim_trailing_whitespace = false
